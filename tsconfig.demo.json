{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node",
      "vite/client"
    ],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "paths": {
      "vite-plugin-herdr": [
        "./src/index.ts"
      ]
    },
    "allowImportingTsExtensions": true
  },
  "include": [
    "demo/**/*.ts",
    "demo/**/*.vue",
    "vite.config.demo.ts"
  ]
}
